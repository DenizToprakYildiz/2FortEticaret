@model List<YazılımProjesi.Models.TF2Item>
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-warning">Admin Paneli</h2>
                <a asp-action="Logout" class="btn btn-danger">
                    <i class="bi bi-box-arrow-right"></i> Çıkış Yap
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card bg-dark mb-4">
                <div class="card-header text-warning">
                    <h4>Stok Yönetimi</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="TF2Market" asp-action="UpdateStock">
                        <div class="mb-3">
                            <label for="itemId" class="form-label text-warning">Ürün</label>
                            <select class="form-select bg-dark text-warning" id="itemId" name="itemId" required>
                                <option value="">Ürün Seçin</option>
                                @foreach (var item in Model)
                                {
                                    <option value="@item.Id">@item.Name - Mevcut Stok: @item.StockCount</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="newStock" class="form-label text-warning">Yeni Stok Miktarı</label>
                            <input type="number" class="form-control bg-dark text-warning" id="newStock" name="newStock" min="0" required>
                        </div>
                        <button type="submit" class="btn btn-warning">Stok Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 