@{
    ViewData["Title"] = "Admin Girişi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark">
                <div class="card-header text-warning">
                    <h3 class="text-center">Admin Girişi</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    <form method="post" asp-action="Login">
                        <div class="mb-3">
                            <label for="username" class="form-label text-warning">Kullanıcı Adı</label>
                            <input type="text" class="form-control bg-dark text-warning" id="username" name="username" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label text-warning">Şifre</label>
                            <input type="password" class="form-control bg-dark text-warning" id="password" name="password" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-warning">Giriş Yap</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 