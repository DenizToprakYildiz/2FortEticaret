@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2 class="text-warning mb-4">Hakkımızda</h2>
            <div class="card bg-dark text-warning">
                <div class="card-body">
                    <h5 class="card-title">Mann Co Shop</h5>
                    <p class="card-text">
                        Mann Co Shop, avustralyum ve eşsiz eşyalar arayanlar için güvenilir ve kaliteli bir alışveriş platformudur. 
                        2025 yılından beri hizmet veren mağazamız, en iyi Mann Co eşyalarını uygun fiyatlarla sizlere sunmaktadır.
                    </p>
                    <p class="card-text">
                        Misyonumuz, müşterilerimize güvenli bir ticaret ortamı sağlamak ve en kaliteli eşyaları
                        uygun fiyatlarla sunmaktır.
                    </p>
                    <p class="card-text">
                        Vizyonumuz, TF2 topluluğunun en güvenilir ve tercih edilen eşya alışveriş platformu olmaktır
                        ve dünyaya açılmak 
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-center justify-content-center">
            <div class="card bg-dark p-3">
                <img src="/images/mann-co-logo.png" alt="Mann Co Shop" class="img-fluid rounded" style="max-height: 300px; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: 2px solid #FFD700;
    }
    
    .card img {
        transition: transform 0.3s ease;
    }
    
    .card:hover img {
        transform: scale(1.05);
    }
</style>     