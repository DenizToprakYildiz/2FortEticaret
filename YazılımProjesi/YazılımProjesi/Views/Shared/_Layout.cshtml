@using YazılımProjesi.Services
@inject IBalanceService BalanceService
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mann Co Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Mann Co Shop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="TF2Market" asp-action="Index">Market</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="TF2Market" asp-action="Cart">
                                <i class="bi bi-cart text-white"></i> Sepet (<span id="cart-count">@await Component.InvokeAsync("CartItemCount")</span>)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="TF2Market" asp-action="PurchaseHistory">
                                <i class="bi bi-clock-history text-white"></i> Satın Alma Geçmişi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle text-white"></i> Hakkımızda
                            </a>
                        </li>
                        @if (HttpContextAccessor.HttpContext?.Session.GetString("IsAdminLoggedIn") == "true")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock text-white"></i> Admin Panel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right text-white"></i> Çıkış
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Login">
                                    <i class="bi bi-shield-lock text-white"></i> Admin Girişi
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="nav-link text-warning fw-bold">
                                <i class="bi bi-wallet2 text-white"></i> Bakiye: $@BalanceService.GetBalance().ToString("N2")
                            </span>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="btn btn-warning btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#addBalanceModal">
                                <i class="bi bi-plus-circle"></i> Bakiye Yükle
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Mann Co Shop
        </div>
    </footer>

    <!-- Bakiye Yükleme Modal -->
    <div class="modal fade" id="addBalanceModal" tabindex="-1" aria-labelledby="addBalanceModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark">
                <div class="modal-header">
                    <h5 class="modal-title text-warning" id="addBalanceModalLabel">Bakiye Yükle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="TF2Market" asp-action="AddBalance" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="amount" class="form-label text-warning">Yüklenecek Miktar ($)</label>
                            <input type="number" class="form-control bg-dark text-warning" id="amount" name="amount" min="1" step="0.01" required>
                        </div>
                        <small class="text-warning">Bakiye yüklemeleri Mann Co tarafından karşılanmaktadır</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-warning">Yükle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function updateCartCount() {
            $.get('/TF2Market/GetCartCount', function(response) {
                $('#cart-count').text(response);
            });
        }
    </script>

    <style>
        .nav-link {
            color: #FFD700 !important;
        }
        .nav-link:hover {
            color: #FFC000 !important;
        }
    </style>
</body>
</html>
